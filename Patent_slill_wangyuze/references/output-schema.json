{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Medtech Patent Roadmap Case Output",
  "type": "object",
  "required": ["schema_version", "case", "run", "metrics", "records", "uncertainty", "failure_cases", "reports", "reproducibility", "contract"],
  "properties": {
    "schema_version": {"type": "string"},
    "case": {"type": "object", "required": ["case_id", "research_object", "jurisdictions", "as_of", "depth"]},
    "run": {"type": "object", "required": ["run_id", "generated_at", "skill_version", "pipeline"]},
    "metrics": {"type": "object"},
    "records": {"type": "object", "required": ["families", "claims", "evidence", "ranking"]},
    "uncertainty": {"type": "object", "required": ["summary", "items"]},
    "failure_cases": {"type": "array"},
    "reports": {"type": "array"},
    "reproducibility": {"type": "object", "required": ["commands", "inputs", "output_hashes"]},
    "contract": {"type": "object", "required": ["schema_version", "schema_path"]}
  }
}
