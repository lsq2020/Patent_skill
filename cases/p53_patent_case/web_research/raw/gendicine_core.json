b/a9/1d82a866e4db56/HDA0000062604000000103.png"}, {"thumbnail":"69/b9/71/399a3b2c67284e/HDA0000062604000000121.png", "full":"e1/23/a1/55a60c84478c9c/HDA0000062604000000121.png"}, {"thumbnail":"f3/8c/04/9d7cfa142301e3/HDA0000062604000000122.png", "full":"c6/20/95/9bbcb117a17f33/HDA0000062604000000122.png"}, {"thumbnail":"d2/9c/56/f7b328da40c4ba/HDA0000062604000000131.png", "full":"06/13/0b/84a14b3abe3790/HDA0000062604000000131.png"}, {"thumbnail":"47/b3/86/574de30969cd9d/HDA0000062604000000132.png", "full":"ee/7b/10/2e221e4f6fe767/HDA0000062604000000132.png"}], "family_metadata":{"aggregated":{"country_status":[{"country_code":"CN", "best_patent_stage":{"state":"ACTIVE"}}]}}}, "is_similar_document":false, "entity_matches":{"additional":0}, "measure_matches":{}}, {"id":"patent/CN102226186B/zh", "rank":5, "patent":{"title":" 以腺病毒为载体的用于治疗恶性肿瘤的激活型Bax基因", "snippet":" 本发明涉及基因工程技术，尤其涉及到一种激活型Bax基因及激活型Bax基因腺病毒。本发明是在Bax蛋白的序列和Bax蛋白的基因完整序列的基础上，克隆出编码激活型Bax蛋白的激活型Bax基因，其cDNA碱基序列如序列表中SeQ ID No.1所述。由复制缺陷型腺病毒载体中插入如序列表中SeQ ID No.1所述的激活型Bax基因，构建而成治疗恶性肿瘤的激活型Bax基因腺病毒。本发明的显著进步在于：本发明的激活型Bax基因腺病毒导入肿瘤细胞后，可以直接激活肿瘤细胞自杀程序，导致肿瘤细胞死亡，克服了重组p53基因腺病毒的间接调节细胞程序化死亡的缺点，抗肿瘤效果显著，杀死肿瘤细胞活性比p53基因腺病 &hellip;", "priority_date":"2011-05-10", "filing_date":"2011-05-10", "grant_date":"2013-01-23", "publication_date":"2013-01-23", "inventor":"高贵", "assignee":"深圳市赛百诺基因技术有限公司", "publication_number":"CN102226186B", "language":"zh", "thumbnail":"43/f2/45/ce9ea2d010b32c/HDA0000060153630000011.png", "pdf":"30/87/40/dd0e1452d5c55b/CN102226186B.pdf", "figures":[{"thumbnail":"63/8e/87/5c3edc2dbdd789/HDA0000060153630000011.png", "full":"38/8f/60/c4b19cacc99050/HDA0000060153630000011.png"}], "family_metadata":{"aggregated":{"country_status":[{"country_code":"CN", "best_patent_stage":{"state":"ACTIVE"}}]}}}, "is_similar_document":false, "entity_matches":{"additional":0}, "measure_matches":{}}, {"id":"patent/CN105936670A/zh", "rank":6, "patent":{"title":" 一种具有热疗效应的基因载体的制备方法", "snippet":" 本发明涉及一种具有热疗效应的基因载体的制备方法，属于生物工程技术领域。首先制备金纳米笼；然后采用4，4’‑二硫代二丁酸、1‑乙基‑(3‑二甲基氨基丙基)碳二亚胺、N‑羟基丁二酰亚胺和聚乙烯亚胺发生酰胺化反应，得到不溶于水的似凝胶材料，将似凝胶材料与巯基乙醇反应得到一端带有巯基、另一端接枝聚乙烯亚胺的阳离子聚合物；最后将得到的金纳米笼与制备的阳离子聚合物混合，对金纳米笼进行表面修饰，再经过离心和清洗后，即得到具有热疗效应的基因载体。本发明制备的载体与质粒DNA形成的复合物具有细胞毒性低，转染效率高等优点，同时该载体还具有热效应，可以实现热疗和基因治疗的双重效果。", "priority_date":"2016-06-27", "filing_date":"2016-06-27", "publication_date":"2016-09-14", "inventor":"韩璐", "assignee":"北京印刷学院", "publication_number":"CN105936670A", "language":"zh", "thumbnail":"", "pdf":"ed/97/cb/40eaaba3fbe01e/CN105936670A.pdf", "family_metadata":{"aggregated":{"country_status":[{"country_code":"CN", "best_patent_stage":{"state":"ACTIVE"}}]}}}, "is_similar_document":false, "entity_matches":{"additional":0}, "measure_matches":{}}, {"id":"patent/CN101130092A/zh", "rank":7, "patent":{"title":" 一种重组腺病毒在制备抗肿瘤药物中的应用", "snippet":" 本发明涉及生物学领域。肺癌是死亡率极高的恶性肿瘤，全身化疗成为主要的治疗方法，但决大多数NSCLC在体内和体外都被证实对化疗不敏感。本发明的目的是提供一种携带人WWOX基因的重组腺病毒在制备抗肿瘤药物中的应用，特别是用于制备化疗药增敏剂。本发明首先构建携带人WWOX基因的重组腺病毒，然后建立耐药模型A549紫杉醇耐药株和基因转移方法，观察腺病毒在A549/T细胞的表达；最终通过体外药敏实验证明WWOX能显著逆转紫杉醇和顺铂的耐药性。本发明可逆转肺癌细胞耐药，为最终解决恶性肿瘤的耐药问题提供新的方法。", "priority_date":"2007-07-17", "filing_date":"2007-07-17", "publication_date":"2008-02-27", "inventor":"李强", "assignee":"中国人民解放军第二军医大学", "publication_number":"CN101130092A", "language":"zh", "thumbnail":"c4/d8/2f/dcea1e974b0a6a/A20071004384700171.png", "pdf":"00/e0/eb/291ffb46df2c38/CN101130092A.pdf", "figures":[{"thumbnail":"5f/b3/82/bcdf01af79cb68/A20071004384700171.png", "full":"b1/f0/a4/c416652684983c/A20071004384700171.png"}, {"thumbnail":"b2/fb/ff/7ed1a663d6db90/A20071004384700181.png", "full":"55/15/27/13944b5eea5f8e/A20071004384700181.png"}], "family_metadata":{"aggregated":{"country_status":[{"country_code":"CN", "best_patent_stage":{"state":"ACTIVE"}}]}}}, "is_similar_document":false, "entity_matches":{"additional":0}, "measure_matches":{}}, {"id":"patent/CN116869930A/zh", "rank":8, "patent":{"title":" 一种稳定腺病毒载体液体制剂的研制及应用", "snippet":" 本发明涉及一种液体制剂，用于稳定具有生物活性的预防类疫苗和治疗类的生物医药制品，该液体制剂包含纯化后的生物制品原液和液体配方。液体配方主要包含盐类缓冲体系、糖类保护剂、蛋白质类保护剂、多元醇及表面活性剂，液体制剂的pH值为5.0～7.5。", "priority_date":"2023-08-08", "filing_date":"2023-08-08", "publication_date":"2023-10-13", "inventor":"高博", "assignee":"北京智飞绿竹生物制药有限公司", "publication_number":"CN116869930A", "language":"zh", "thumbnail":"", "pdf":"3f/81/61/47c17e7fbef286/CN116869930A.pdf", "family_metadata":{"aggregated":{"country_status":[{"country_code":"CN", "best_patent_stage":{"state":"ACTIVE"}}]}}}, "is_similar_document":false, "entity_matches":{"additional":0}, "measure_matches":{}}, {"id":"patent/CN105308040B/zh", "rank":9, "patent":{"title":" 1,3-二氨基环戊烷甲酰胺衍生物", "snippet":" 式I的化合物，其中，R 1 、R 4 、R 6 、R、X 1 、X 2 、X 3 、X 4 、q和W具有权利要求1所示的含义，是脂肪酸合酶的抑制剂，并且尤其可以用于治疗疾病，例如癌症、心血管疾病、中枢神经系统损伤和各种形式的炎症。", "priority_date":"2013-06-21", "filing_date":"2014-05-09", "grant_date":"2019-06-04", "publication_date":"2019-06-04", "inventor":"C.察克拉基迪斯", "assignee":"默克专利股份公司", "publication_number":"CN105308040B", "language":"zh", "thumbnail":"", "pdf":"05/a6/99/f4f735f229d9d4/CN105308040B.pdf", "family_metadata":{"aggregated":{"country_status":[{"country_code":"WO", "best_patent_stage":{"state":"NOT_ACTIVE"}}, {"country_code":"EP", "best_patent_stage":{"state":"ACTIVE"}}, {"country_code":"US", "best_patent_stage":{"state":"ACTIVE"}}, {"country_code":"CN", "best_patent_stage":{"state":"ACTIVE"}}, {"country_code":"JP", "best_patent_stage":{"state":"ACTIVE"}}, {"country_code":"AR", "best_patent_stage":{"state":"UNKNOWN"}}, {"country_code":"AU", "best_patent_stage":{"state":"ACTIVE"}}, {"country_code":"BR", "best_patent_stage":{"state":"NOT_ACTIVE"}}, {"country_code":"CA", "best_patent_stage":{"state":"ACTIVE"}}, {"country_code":"ES", "best_patent_stage":{"state":"ACTIVE"}}, {"country_code":"IL", "best_patent_stage":{"state":"ACTIVE"}}]}}}, "is_similar_document":false, "entity_matches":{"additional":0}, "measure_matches":{}}]}], "chem_exhausted":false, "summary":{"assignee":[{"key":"Total", "value":1000, "frequency":[{"key":"2025-2028", "value":1}, {"key":"2022-2025", "value":2}, {"key":"2019-